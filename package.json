{
  "name": "mathvision-recovered-source",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#production-react": {
      "types": "./src/runtime/reactFromProductionBundle.d.ts",
      "default": "./src/runtime/reactFromProductionBundle.js"
    }
  },
  "scripts": {
    "import:gao": "tsx tools/import-gao-workflow.ts",
    "recover:chunks": "node tools/recover-chunks.mjs",
    "recover:jsx": "node tools/recover-jsx.mjs",
    "recover:names": "node tools/restore-primary-names.mjs",
    "assemble": "node tools/assemble-source.mjs",
    "analyze": "node tools/analyze-modules.mjs",
    "inventory": "node tools/recovery-inventory.mjs",
    "recover": "npm run recover:chunks && npm run analyze && npm run recover:jsx && npm run recover:names && npm run assemble",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.maintainable.json",
    "check:recovered-syntax": "tsc -p tsconfig.recovered-views.json",
    "test": "tsx --tsconfig tsconfig.test.json --test tests/*.test.ts",
    "verify:logos": "node tools/verify-logo-removal.mjs",
    "verify": "npm run inventory && npm run typecheck && npm run check:recovered-syntax && npm test && npm run build && npm run verify:logos"
  },
  "devDependencies": {
    "@babel/generator": "^7.28.3",
    "@babel/parser": "^7.28.3",
    "@babel/traverse": "^7.28.3",
    "@babel/types": "^7.28.2",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "webcrack": "^2.16.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "axios": "1.19.0",
    "katex": "0.16.45",
    "lucide-react": "1.16.0",
    "pdfjs-dist": "4.10.38",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  }
}
